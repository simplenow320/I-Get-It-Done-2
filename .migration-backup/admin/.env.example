# Same Postgres database the Express API uses.
NUXT_DATABASE_URL=postgres://user:pass@host:5432/db
# Random string, at least 32 characters. Signs the admin session cookie.
NUXT_SESSION_PASSWORD=
# Comma-separated. Only these existing app accounts can sign in to the admin.
NUXT_ADMIN_EMAILS=you@example.com

# Optional: Finance page. RevenueCat v2 secret key (sk_...) with Charts & Metrics read access, and the project ID.
NUXT_REVENUECAT_SECRET_KEY=
NUXT_REVENUECAT_PROJECT_ID=
# Optional: Deepgram key that can read billing balances (defaults to DEEPGRAM_API_KEY).
NUXT_DEEPGRAM_API_KEY=
# Deepgram price per audio minute (nova-3), used for AI cost.
NUXT_DEEPGRAM_USD_PER_MINUTE=0.0043
# OpenAI price per 1M tokens for task extraction (gpt-4.1-mini). Used for AI cost.
NUXT_OPENAI_INPUT_USD_PER_MILLION=0.4
NUXT_OPENAI_OUTPUT_USD_PER_MILLION=1.6
